rules_version = '2';
// Reglas de seguridad de la carta. Pegar en Firebase → Firestore Database → Reglas → Publicar.
// Reemplazar UID_DEL_DUENO por el UID del usuario del local (Authentication → Usuarios).
service cloud.firestore {
  match /databases/{database}/documents {
    function esDueno() { return request.auth != null && request.auth.uid == "UID_DEL_DUENO"; }

    // Cambios del panel (precios, fotos, aviso, horarios): todos leen, solo el dueño escribe
    match /carta/{doc} {
      allow read: if true;
      allow write: if esDueno();
    }
    // Fotos subidas desde el panel
    match /fotos/{id} {
      allow read: if true;
      allow write: if esDueno();
    }
    // Pedidos: cada cliente solo ve y escribe los suyos; el dueño ve todos
    match /pedidos/{uid} {
      allow read: if esDueno() || (request.auth != null && request.auth.uid == uid);
      allow write: if request.auth != null && request.auth.uid == uid
                   && request.resource.data.lista is list && request.resource.data.lista.size() <= 30;
    }
    // Estado de cada pedido: lo cambia solo el local; el cliente lo lee
    match /estados/{uid} {
      allow read: if esDueno() || (request.auth != null && request.auth.uid == uid);
      allow write: if esDueno();
    }
  }
}
